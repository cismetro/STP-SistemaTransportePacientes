                                    <a href="{url_for('pacientes_excluir', paciente_id=paciente.id)}" class="btn btn-small" style="background: var(--danger-color); padding: 0.35rem 0.75rem; font-size: 0.875rem;" onclick="return confirm('Tem certeza que deseja excluir este paciente?');" title="Excluir">🗑️</a>
