        {
            'cpf': '086.176.970-44',
            'nome': 'ANA PAULA COSTA',
            'nasc': date(1990, 1, 15),
            'rua': 'RUA XV DE NOVEMBRO', 'num': '45', 'bairro': 'VILA NOVA',
            'tel': '19955554444', 'tel2': '',
            'cond': '',
            'hora': time_cls(15, 30, 0),
            'destino': 'CAPS / RUA SAUDE MENTAL, 12',
            'origem': 'COSMÓPOLIS/SP — POSTO COSMÓPOLIS',
            'tipo': 'consulta',
